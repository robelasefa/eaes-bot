TELEGRAM_BOT_TOKEN=your-token

DATABASE_URL=sqlite+aiosqlite:///tracking.db

EAES_URL=https://result.eaes.et/
EAES_POLL_INTERVAL_SECONDS=300
EAES_MAX_CONCURRENT=3
EAES_MAX_TRACKED_PER_CHAT=10
EAES_MAX_ATTEMPTS=50
EAES_FETCH_TIMEOUT_SECONDS=60

EAES_JITTER_MIN_SECONDS=0.5
EAES_JITTER_MAX_SECONDS=2.5
EAES_BROWSER_HEALTH_CHECK_TIMEOUT_SECONDS=15

# Chrome/nodriver. On headless Linux, set EAES_USE_VIRTUAL_DISPLAY=1 to have
# the bot start a virtual display itself, or run under `xvfb-run` instead.
EAES_CHROME_PROFILE_DIR=./chrome_profile
EAES_CHROME_EXECUTABLE_PATH=
EAES_USE_VIRTUAL_DISPLAY=0